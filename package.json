{
  "name": "coursetoical",
  "version": "2.0.0",
  "private": true,
  "description": "Local timetable to iCalendar desktop app with React and Ant Design",
  "main": "electron/main.cjs",
  "author": "Reese0001",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "antd": "^5.27.2",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.coursetoical.desktop",
    "productName": "CourseToIcal",
    "directories": {
      "output": "publish-react"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "signAndEditExecutable": false
    }
  }
}
